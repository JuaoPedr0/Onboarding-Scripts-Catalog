{
  "$schema": "../../schema/tool.schema.json",
  "slug": "wazuh",
  "titulo": "Wazuh Agent",
  "categoria": "Segurança",
  "ordem": 20,
  "ativo": true,
  "plataformas": {
    "windows": {
      "arquivo": "windows.ps1",
      "descricao": "Agente de segurança/EDR com enrollment no manager. Idempotente, testa conectividade antes de mexer no host e grava ossec.conf mínimo (config operacional vem dos grupos)."
    },
    "linux": {
      "arquivo": "linux.sh",
      "descricao": "Agente de segurança/EDR com enrollment no manager. Configura o repositório (apt/yum), instala o pacote e valida o registro pelo client.keys."
    }
  },
  "parametros": [
    {
      "nome": "manager",
      "tipo": "host",
      "obrigatorio": true,
      "padrao": null,
      "aliases": [
        "wazuh_manager"
      ],
      "descricao": "IP ou FQDN do Wazuh manager",
      "exemplo": "wazuh.exemplo.local",
      "var": {
        "windows": "Manager",
        "linux": "WAZUH_MANAGER"
      }
    },
    {
      "nome": "group",
      "tipo": "lista",
      "obrigatorio": false,
      "padrao": null,
      "regex": "^[A-Za-z0-9._-]{1,128}$",
      "aliases": [
        "groups"
      ],
      "descricao": "Grupo(s) do agente no manager, separados por vírgula. Vazio deixa só no grupo padrão",
      "var": {
        "windows": "AgentGroup",
        "linux": "WAZUH_AGENT_GROUPS_CSV"
      },
      "porPlataforma": {
        "windows": {
          "exemplo": "Windows,Hosts_HyperV"
        },
        "linux": {
          "exemplo": "Linux"
        }
      }
    },
    {
      "nome": "version",
      "tipo": "string",
      "obrigatorio": false,
      "padrao": "latest",
      "regex": "^(latest|\\d+\\.\\d+\\.\\d+(-\\d+)?)$",
      "aliases": [
        "wazuh_version"
      ],
      "descricao": "Versão do agente: latest, X.Y.Z ou X.Y.Z-R",
      "var": {
        "windows": "WazuhVersion",
        "linux": "WAZUH_VERSION"
      }
    },
    {
      "nome": "name",
      "tipo": "string",
      "obrigatorio": false,
      "padrao": null,
      "regex": "^[A-Za-z0-9._-]{1,64}$",
      "aliases": [
        "agent_name"
      ],
      "var": {
        "windows": "AgentName",
        "linux": "WAZUH_AGENT_NAME"
      },
      "porPlataforma": {
        "windows": {
          "descricao": "Nome do agente no manager. Vazio usa o nome da máquina"
        },
        "linux": {
          "descricao": "Nome do agente no manager. Vazio usa o hostname"
        }
      }
    },
    {
      "nome": "protocol",
      "tipo": "enum",
      "obrigatorio": false,
      "padrao": "tcp",
      "valores": [
        {
          "valor": "tcp",
          "descricao": "Padrão, recomendado"
        },
        {
          "valor": "udp",
          "descricao": "Só se o manager estiver configurado em UDP"
        }
      ],
      "descricao": "Protocolo de comunicação com o manager",
      "var": {
        "windows": "Protocol",
        "linux": "WAZUH_PROTOCOL"
      }
    },
    {
      "nome": "manager_port",
      "tipo": "int",
      "obrigatorio": false,
      "padrao": 1514,
      "min": 1,
      "max": 65535,
      "descricao": "Porta de comunicação do agente com o manager",
      "var": {
        "windows": "ManagerPort",
        "linux": "WAZUH_MANAGER_PORT"
      }
    },
    {
      "nome": "enroll_port",
      "tipo": "int",
      "obrigatorio": false,
      "padrao": 1515,
      "min": 1,
      "max": 65535,
      "descricao": "Porta de enrollment (authd)",
      "var": {
        "windows": "EnrollPort",
        "linux": "WAZUH_REGISTRATION_PORT"
      }
    },
    {
      "nome": "force",
      "tipo": "bool",
      "obrigatorio": false,
      "padrao": false,
      "descricao": "Força reinstalação limpa mesmo com o agente já conforme",
      "var": {
        "windows": "Force",
        "linux": "FORCE_REINSTALL"
      }
    },
    {
      "nome": "preserve_keys",
      "tipo": "bool",
      "obrigatorio": false,
      "padrao": false,
      "descricao": "Mantém o client.keys atual, sem gerar novo registro no manager",
      "var": {
        "windows": "PreserveKeys",
        "linux": "PRESERVE_KEYS"
      }
    },
    {
      "nome": "skip_connectivity",
      "tipo": "bool",
      "obrigatorio": false,
      "padrao": false,
      "descricao": "Pula o teste de portas antes de mexer no host",
      "var": {
        "windows": "SkipConnectivityCheck",
        "linux": "SKIP_CONNECTIVITY"
      }
    },
    {
      "nome": "skip_signature",
      "tipo": "bool",
      "obrigatorio": false,
      "padrao": false,
      "descricao": "Pula a validação da assinatura do MSI",
      "var": {
        "windows": "SkipSignatureCheck"
      }
    }
  ]
}
