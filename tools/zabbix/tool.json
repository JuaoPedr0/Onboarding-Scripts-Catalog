{
  "$schema": "../../schema/tool.schema.json",
  "slug": "zabbix",
  "titulo": "Zabbix Agent 2",
  "categoria": "Monitoramento",
  "ordem": 10,
  "ativo": true,
  "plataformas": {
    "windows": {
      "arquivo": "windows.ps1",
      "descricao": "Agente de monitoramento com autorregistro. Instala silencioso, aguarda o Windows Installer, libera a porta no firewall e valida o serviço."
    },
    "linux": {
      "arquivo": "linux.sh",
      "descricao": "Agente de monitoramento com autorregistro. Detecta a distro (apt/dnf), configura o repositório oficial e sobe o serviço."
    }
  },
  "parametros": [
    {
      "nome": "zabbix_server",
      "tipo": "host",
      "obrigatorio": true,
      "padrao": null,
      "descricao": "Endereço do servidor ou proxy Zabbix (SERVER e SERVERACTIVE)",
      "exemplo": "zabbix.exemplo.local",
      "var": {
        "windows": "ZabbixServer",
        "linux": "ZABBIX_SERVER"
      }
    },
    {
      "nome": "metadata",
      "tipo": "string",
      "obrigatorio": true,
      "padrao": null,
      "regex": "^[A-Za-z0-9 ._:,;=-]{1,255}$",
      "descricao": "HostMetadata usado nas regras de autorregistro",
      "var": {
        "windows": "Metadata",
        "linux": "ZABBIX_METADATA"
      },
      "porPlataforma": {
        "windows": {
          "exemplo": "Windows"
        },
        "linux": {
          "exemplo": "Linux"
        }
      }
    },
    {
      "nome": "hostname",
      "tipo": "string",
      "obrigatorio": false,
      "padrao": null,
      "regex": "^[A-Za-z0-9._-]{1,128}$",
      "var": {
        "windows": "Hostname",
        "linux": "ZABBIX_HOSTNAME"
      },
      "porPlataforma": {
        "windows": {
          "descricao": "Nome do host no Zabbix. Vazio usa o nome da máquina",
          "exemplo": "SRV-APP01"
        },
        "linux": {
          "descricao": "Nome do host no Zabbix. Vazio usa o hostname da máquina",
          "exemplo": "srv-app01"
        }
      }
    },
    {
      "nome": "version",
      "tipo": "string",
      "obrigatorio": false,
      "padrao": "7.4",
      "var": {
        "windows": "VersionAgent",
        "linux": "ZABBIX_VERSION"
      },
      "porPlataforma": {
        "windows": {
          "descricao": "Versão do agente: major.minor (7.4 = última do branch) ou completa (7.4.13)",
          "regex": "^\\d+\\.\\d+(\\.\\d+)?$"
        },
        "linux": {
          "descricao": "Branch do repositório oficial do Zabbix (ex.: 7.4)",
          "regex": "^\\d+\\.\\d+$"
        }
      }
    },
    {
      "nome": "listen_port",
      "tipo": "int",
      "obrigatorio": false,
      "padrao": 10050,
      "min": 1,
      "max": 65535,
      "descricao": "Porta de escuta do agente (liberada no firewall)",
      "var": {
        "windows": "ListenPort"
      }
    }
  ]
}
